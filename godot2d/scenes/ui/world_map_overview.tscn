[sub_resource type="Shader" id="TerrainInk"]
code = "shader_type canvas_item;
void fragment() {
 vec2 uv = (floor(UV * vec2(320.0, 160.0)) + 0.5) / vec2(320.0, 160.0);
 vec3 ink = texture(TEXTURE, uv).rgb;
 float luma = dot(ink, vec3(0.299, 0.587, 0.114));
 ink = mix(vec3(luma), ink, 0.65);
 ink = mix(vec3(0.955, 0.944, 0.855), ink, 0.48);
 ink = mix(vec3(0.955, 0.944, 0.855), ink, smoothstep(0.0, 0.075, UV.y));
 ink = mix(ink, vec3(0.665, 0.800, 0.785), smoothstep(0.90, 1.0, UV.y));
 COLOR = vec4(ink, 1.0);
}"

