metadata/title = "祖辈的旧屋"
metadata/body = "青绿门廊还留着旧船板的纹路。\n靠近门口按 E 开门，回家歇一歇。"
[node name="garden" type="Marker2D" parent="InteractPoints"]
position = Vector2(168, 234)
metadata/title = "门前小菜园"
metadata/body = "两畦蔬菜挨着海风生长。\n本版可查看场景，种植和收获尚未开放。"
[node name="market" type="Marker2D" parent="InteractPoints"]
position = Vector2(442, 236)
metadata/title = "补帆海鲜摊"
metadata/body = "旧帆布又缝上了一块新的补丁。\n鱼摊陈列已就位，交易系统尚未开放。"
[node name="pier" type="Marker2D" parent="InteractPoints"]
position = Vector2(440, 364)
metadata/title = "归航的小码头"
metadata/body = "浪花轻拍木桩，渔船停在岸旁。\n沿着台阶看看潮位，今天不必急着出海。"
[node name="tide" type="Marker2D" parent="InteractPoints"]
position = Vector2(296, 302)
metadata/title = "潮汐台阶"
metadata/body = "现在是低潮，沿台阶走下沙滩。\n靠近海产按E拾取；本版暂不模拟涨落潮。"

