extends "res://tests/test_life_farming_native.gd"
# Isolated UI fixture, not evidence of earning these items through production.
func run() -> void:
	evidence="/private/tmp/coastal-bag-native"
	DirAccess.make_dir_recursive_absolute(evidence)
	w=load("res://scenes/harbor.tscn").instantiate()
	w.set_meta("save_directory","/private/tmp/coastal-bag-texture-native-save")
	root.add_child(w)
	check("native_renderer",DisplayServer.get_name()!="headless")
	check("isolated_save",w.save_service.directory=="/private/tmp/coastal-bag-texture-native-save")
	if w.save_service.directory!="/private/tmp/coastal-bag-texture-native-save":finish();return
	check("new_game",w.start_new_game("背包美术"))
	for id in ["tomato","lettuce","tomato_seed","lettuce_seed","clam","snail","kelp"]:w.foraging.bag.add(id,6)
	check("fixture_saved",w.save_progress())
	for i in range(4):await process_frame
	await key(KEY_B,true)
	await key(KEY_B,false)
	check("B_opens_bag",w.journal.mode=="bag")
	var page=w.journal.bag_page
	var grid=page.get_node("BagGrid")
	await click(grid.get_node("bag_0"))
	check("tomato_has_image",grid.get_node("bag_0/Icon").item_id=="tomato" and grid.get_node("bag_0/Icon").crop_texture().resource_path.ends_with("tomato_mature.png"))
	await capture("01-tomato-fixed")
	await click(page.get_node("Filter/filter_1"))
	check("sea_filter",grid.get_node("bag_0").disabled and not grid.get_node("bag_4").disabled)
	await click(page.get_node("Filter/filter_2"))
	check("food_filter",not grid.get_node("bag_0").disabled and grid.get_node("bag_4").disabled)
	await click(page.get_node("Filter/filter_0"))
	await click(grid.get_node("bag_0"))
	await click(page.get_node("Details/split"))
	check("split_dialog",w.journal.modal_kind=="quantity")
	for i in range(4):await click(w.journal.get_node("Root/Dialogs/QuantityDialog/Panel/less"))
	await click(w.journal.get_node("Root/Dialogs/QuantityDialog/Panel/quantity_ok"))
	await click(grid.get_node("bag_7"))
	check("split_preserves_total",w.foraging.bag.count_item("tomato")==6 and w.foraging.bag.snapshot()[7].id=="tomato" and w.foraging.bag.snapshot()[7].amount==1)
	await click(page.get_node("Details/move"))
	await click(grid.get_node("bag_0"))
	check("merge_preserves_total",w.foraging.bag.snapshot()[0].amount==6 and w.foraging.bag.snapshot()[7].id=="")
	await click(page.get_node("sort"))
	check("sort_preserves_total",w.foraging.bag.count_item("tomato")==6 and w.foraging.bag.count_item("lettuce")==6)
	await capture("02-sorted-backpack")
	await click(w.journal.get_node("Root/PauseMenu/Surface/Tabs/tab_profile"))
	check("profile_tab",w.journal.mode=="profile")
	await click(w.journal.get_node("Root/PauseMenu/Surface/Tabs/tab_settings"))
	check("settings_tab",w.journal.mode=="settings")
	await click(w.journal.get_node("Root/PauseMenu/Surface/Tabs/tab_bag"))
	check("bag_tab",w.journal.mode=="bag")
	await key(KEY_ESCAPE,true)
	await key(KEY_ESCAPE,false)
	check("Esc_closes",w.journal.mode=="")
	check("continue_saved_items",w.continue_game() and w.foraging.bag.count_item("tomato")==6 and w.foraging.bag.count_item("kelp")==6)
	check("wallet_unchanged",w.foraging.life.wallet==100)
	finish()
