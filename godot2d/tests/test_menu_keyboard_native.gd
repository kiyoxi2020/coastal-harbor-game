extends "res://tests/test_life_farming_native.gd"
func press(code:int):
	await key(code,true);await key(code,false)
func focus_is(node:Control) -> bool:return root.gui_get_focus_owner()==node
func run() -> void:
	evidence="/private/tmp/coastal-menu-keyboard-native"
	DirAccess.make_dir_recursive_absolute(evidence)
	w=load("res://scenes/harbor.tscn").instantiate()
	w.set_meta("save_directory","/private/tmp/coastal-menu-keyboard-save")
	root.add_child(w)
	check("native_renderer",DisplayServer.get_name()!="headless")
	check("isolated",w.save_service.directory=="/private/tmp/coastal-menu-keyboard-save")
	if w.save_service.directory!="/private/tmp/coastal-menu-keyboard-save":finish();return
	check("new_game",w.start_new_game("键盘导航"))
	w.foraging.bag.add("tomato",6);w.foraging.bag.add("clam",1) # isolated UI fixture
	await press(KEY_B)
	await press(KEY_D);check("D_selects",w.journal.selected_index==1)
	await press(KEY_A);check("A_selects",w.journal.selected_index==0)
	await press(KEY_W);await press(KEY_W)
	await press(KEY_D);await press(KEY_E)
	check("keyboard_profile",w.journal.mode=="profile")
	await press(KEY_D);await press(KEY_E)
	check("keyboard_settings",w.journal.mode=="settings")
	await press(KEY_S)
	var slider=w.journal.settings_page.get_node("Master")
	check("slider_focus",focus_is(slider))
	var volume:float=slider.value
	await press(KEY_A);check("slider_A_adjusts",slider.value<volume)
	await capture("01-settings-focus")
	await press(KEY_W);await press(KEY_A);await press(KEY_A);await press(KEY_E)
	check("keyboard_back_to_bag",w.journal.mode=="bag")
	await press(KEY_S);await press(KEY_S)
	await press(KEY_W)
	for i in range(5):await press(KEY_D)
	check("keyboard_action",focus_is(w.journal.bag_page.get_node("Details/move")))
	await press(KEY_S);await press(KEY_S)
	check("keyboard_sort_focus",focus_is(w.journal.bag_page.get_node("sort")))
	await capture("02-sort-focus")
	await press(KEY_E)
	check("sort_no_loss",w.foraging.bag.count_item("tomato")==6 and w.foraging.bag.count_item("clam")==1)
	await press(KEY_ESCAPE);await press(KEY_ESCAPE)
	if not await walk_to(w.exterior.get_node("InteractPoints/market").position,"market"):finish();return
	await tap_e()
	var page=w.journal.get_node("Root/TradePage")
	var seq:int=w.foraging.life.action_seq
	await press(KEY_RIGHT);check("trade_right",page.item_id=="tomato_seed")
	await press(KEY_A);check("trade_A",page.item_id=="lettuce_seed")
	check("preview_no_purchase",w.foraging.life.action_seq==seq)
	await press(KEY_S);await press(KEY_E)
	check("keyboard_quantity",page.get_node("Surface/Quantity").value==2)
	await press(KEY_D)
	check("keyboard_submit_focus",focus_is(page.get_node("Surface/Submit")))
	await capture("03-buy-focus")
	await press(KEY_E)
	check("buy_once",w.foraging.life.wallet==90 and w.foraging.bag.count_item("lettuce_seed")==2 and w.foraging.life.action_seq==seq+1)
	await press(KEY_W);await press(KEY_W);await press(KEY_D);await press(KEY_E)
	check("sell_tab_keyboard",page.direction=="sell")
	await press(KEY_S)
	check("sell_item_keyboard",page.item_id=="clam")
	await press(KEY_S)
	# Amount2 exceeds the one clam; use left to focus minus, then E to set1.
	await press(KEY_A);await press(KEY_E)
	await press(KEY_D);await press(KEY_D)
	check("sell_submit_focus",focus_is(page.get_node("Surface/Submit")))
	await press(KEY_E)
	check("sell_once",w.foraging.life.wallet==98 and w.foraging.bag.count_item("clam")==0)
	await capture("04-sell-keyboard")
	await press(KEY_ESCAPE);await press(KEY_ESCAPE)
	check("reload_keyboard_economy",w.continue_game() and w.foraging.life.wallet==98 and w.foraging.bag.count_item("lettuce_seed")==2)
	finish()
